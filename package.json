{
  "name": "label-bro-frontend-ts",
  "version": "0.1.0",
  "description": "TypeScript for labelBro frontend - Flask web application for Brother QL-800 Label Printers",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build-with-error-reporting.js",
    "build:original": "esbuild src/main.ts --outfile=label_bro/static/js/bundle.js --target=es2020 --format=iife --sourcemap --bundle --minify",
    "watch": "node build-with-error-reporting.js --watch",
    "watch:original": "esbuild src/main.ts --outfile=label_bro/static/js/bundle.js --target=es2020 --format=iife --sourcemap --bundle --watch",
    "dev": "concurrently \"npm run typecheck -- --watch\" \"npm run watch\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:validation": "jest --testPathPattern=validation",
    "test:integration": "jest --testPathPattern=integration",
    "test:cross-system": "jest --testPathPattern=cross-system-logging"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "concurrently": "^8.2.0",
    "esbuild": "^0.19.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "jsdom": "^22.1.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typia": "^5.3.0",
    "typescript": "^5.2.0"
  }
}