{
  "name": "label-bro-frontend-ts",
  "version": "0.1.0",
  "description": "TypeScript for labelBro frontend - Flask web application for Brother QL-800 Label Printers",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build-with-error-reporting.js",
    "build:original": "esbuild src/main.tsx --outfile=label_bro/static/js/bundle.js --target=es2020 --format=iife --sourcemap --bundle --minify --jsx=automatic --jsx-import-source=react",
    "watch": "node build-with-error-reporting.js --watch",
    "watch:original": "esbuild src/main.tsx --outfile=label_bro/static/js/bundle.js --target=es2020 --format=iife --sourcemap --bundle --watch --jsx=automatic --jsx-import-source=react",
    "dev": "concurrently \"npm run typecheck -- --watch\" \"npm run watch\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:validation": "jest --testPathPattern=validation",
    "test:integration": "jest --testPathPattern=integration",
    "test:cross-system": "jest --testPathPattern=cross-system-logging"
  },
  "devDependencies": {
    "@sentry/browser": "^10.8.0",
    "@sentry/integrations": "^7.114.0",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.0",
    "esbuild": "^0.19.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "jest-junit": "^16.0.0",
    "jsdom": "^22.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.2.0",
    "typia": "^5.3.0",
    "vite": "^7.0.6",
    "web-vitals": "^5.1.0",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
